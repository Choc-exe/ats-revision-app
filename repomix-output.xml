                                borderColor: "var(--sim-border)",
                                color: "var(--sim-text-secondary)",
                              }
                        }
                        className="px-2.5 py-1 text-[11px] font-mono font-bold rounded-md border transition-colors cursor-pointer hover:opacity-90"
                      >
