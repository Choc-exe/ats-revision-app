              {order === 2 &&
              bodeData.hasResonance &&
              bodeData.wr !== null &&
              bodeData.mrDb !== null
                ? `ω_r = ${fmtFrFixed(bodeData.wr, 2)} rad/s (${fmtFrFixed(bodeData.mrDb, 1)} dB)`
