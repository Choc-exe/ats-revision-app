        { "id": "B", "text": "$H_{\\text{réduit}}(p) = \\frac{10}{1 + p}$ et $t_{r5\\%} \\approx 3\\text{ s}$" },
        { "id": "C", "text": "$H_{\\text{réduit}}(p) = \\frac{10}{1 + 50\\,p}$ et $t_{r5\\%} \\approx 150\\text{ s}$" },
        { "id": "D", "text": "$H_{\\text{réduit}}(p) = \\frac{1}{1 + p}$ et $t_{r5\\%} \\approx 1\\text{ s}$" }
      ],
      "correctOptionId": "B",
